  command = ${LAUNCHER}${CODE_CHECK}D:\programs\msys64\clangarm64\bin\clang.exe $DEFINES $INCLUDES $FLAGS -MD -MT $out -MF $DEP_FILE -o $out -c $in
  description = Building C object $out


#############################################
# Rule for linking C static library.

rule C_STATIC_LIBRARY_LINKER__vorbisfile_Debug
  command = C:\WINDOWS\system32\cmd.exe /C "$PRE_LINK && D:\programs\cmake\bin\cmake.exe -E rm -f $TARGET_FILE && D:\programs\msys64\clangarm64\bin\llvm-ar.exe qc $TARGET_FILE $LINK_FLAGS $in && D:\programs\msys64\clangarm64\bin\llvm-ranlib.exe $TARGET_FILE && $POST_BUILD"
  description = Linking C static library $TARGET_FILE
  restat = $RESTAT


#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = D:\programs\cmake\bin\cmake.exe --regenerate-during-build -SD:\uni\lab_2_3\lab_2_3 -BD:\uni\lab_2_3\lab_2_3\out\build\Debug
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = D:\programs\msys64\clangarm64\bin\ninja.exe $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = D:\programs\msys64\clangarm64\bin\ninja.exe -t targets
  description = All primary targets available:

